 "sentences": [
  {
   "text": "App frozen and won't close? Force it shut with one command.",
   "s": 0.06,
   "e": 3.397
  },
  {
   "text": "Open Command Prompt, type task list, and press Enter.",
   "s": 3.817,
   "e": 6.924
  },
  {
   "text": "Find the app's name in the list, like notepad dot exe.",
   "s": 7.344,
   "e": 10.589
  },
  {
   "text": "Now type task kill, slash I M, notepad dot exe, slash F, and press Enter.",
   "s": 11.009,
   "e": 16.268
  },
  {
   "text": "The app closes right away, but anything unsaved in it is lost.",
   "s": 16.688,
   "e": 20.471
  },
  {
   "text": "Follow for more Windows fixes.",
   "s": 20.891,
   "e": 22.459
  }
