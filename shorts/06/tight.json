 "sentences": [
  {
   "text": "Here is a hidden setting that makes frozen apps easy to close.",
   "s": 0.13,
   "e": 3.445
  },
  {
   "text": "Open Settings, then System, then For developers.",
   "s": 3.825,
   "e": 6.878
  },
  {
   "text": "Turn on End task.",
   "s": 7.258,
   "e": 8.456
  },
  {
   "text": "Now right-click any app on your taskbar.",
   "s": 8.836,
   "e": 10.983
  },
  {
   "text": "You get a new option called End task.",
   "s": 11.363,
   "e": 13.32
  },
  {
   "text": "Click it, and the app closes right away, even if it's frozen.",
   "s": 13.7,
   "e": 17.081
  },
  {
   "text": "No more opening Task Manager every time.",
   "s": 17.461,
   "e": 19.997
  }
